CREATE DEFINER=`root`@`localhost` PROCEDURE `agregarAlCarrito`(
    IN p_oGetDateNow DATETIME,
    IN p_idProducto INT,
    IN p_cantidad INT,
    IN p_idUsuario INT,
    IN p_guest_id VARCHAR(255)
)
BEGIN
    SET @idCart = 0;

    -- Localizar el carrito existente
    SELECT idCart INTO @idCart
    FROM carts
    WHERE (idUser = p_idUsuario AND p_idUsuario <> 0)
       OR (guest_id = p_guest_id AND p_guest_id <> '')
    LIMIT 1;

    -- Si no existe, crearlo (idCart en 'carts' también debería ser AI)
    IF @idCart = 0 OR @idCart IS NULL THEN
        INSERT INTO carts(createDate, updateDate, idUser, guest_id)
        VALUES (p_oGetDateNow, p_oGetDateNow, p_idUsuario, p_guest_id);
        
        SET @idCart = LAST_INSERT_ID();
    END IF;

    -- Insertar en cart_items (MySQL generará el 'keyx' automáticamente)
    INSERT INTO cart_items(createDate, updateDate, idCart, idProducto, cantidad, precio)
    SELECT 
        p_oGetDateNow, 
        p_oGetDateNow, 
        @idCart, 
        p_idProducto, 
        p_cantidad, 
        precio
    FROM productos
    WHERE idProducto = p_idProducto;

    -- Retornar respuesta al Front-end
    SELECT @idCart AS idCart, LAST_INSERT_ID() AS idItem, 'Éxito' AS message;
END ;;
