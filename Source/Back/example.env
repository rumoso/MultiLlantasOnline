PORT=[port-api]
SECRETPRIVATEKEY=EST03SPUBL1CK3Y
ENCRYPTION_KEY=[clave-random-de-exactamente-32-caracteres]

DATABASE=[databasename]
USERDB=[userdatabase]
PASSWORD=[password_database]

SERVER=[URL-API]
PORT_SQL=3306

DATABASE_TYPE=mysql

# Lista separada por comas de origenes permitidos por CORS (sin espacios extra necesarios)
# ej. produccion: https://tienda.multillantas.com
ALLOWED_ORIGINS=[https://dominio-real-produccion.com]

# ---- Mercado Pago ----
# Credenciales de la cuenta (usar las de PRUEBA/sandbox en desarrollo).
# NUNCA subir valores reales al repo.
MP_ACCESS_TOKEN=[access-token-de-mercado-pago]
# Clave secreta para validar la firma de los webhooks (panel de MP > Webhooks)
MP_WEBHOOK_SECRET=[secreto-de-firma-del-webhook]
# A donde regresa el navegador despues de pagar (Front, no Back).
# OJO: van ENTRE COMILLAS. El "#" del hash routing de Angular hace que
# dotenv trunque el valor si se dejan sin comillas.
MP_SUCCESS_URL="[http://localhost:4201/#/Multillantas/checkout/resultado]"
MP_FAILURE_URL="[http://localhost:4201/#/Multillantas/checkout/resultado]"
MP_PENDING_URL="[http://localhost:4201/#/Multillantas/checkout/resultado]"
# Horas de vigencia de la preferencia (para que los OXXO no pagados caduquen)
MP_EXPIRACION_HORAS=72